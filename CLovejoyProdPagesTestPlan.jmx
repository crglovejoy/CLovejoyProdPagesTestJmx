            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
            <intProp name="HTTP2Sampler.uiTabIndex">0</intProp>
            <boolProp name="HTTP2Sampler.http1_upgrade">false</boolProp>
            <stringProp name="HTTP2Sampler.profile">browser-like</stringProp>
            <boolProp name="HTTP2Sampler.enableHttp3">false</boolProp>
            <boolProp name="HTTP2Sampler.enableHttp2">true</boolProp>
            <boolProp name="HTTP2Sampler.enableHttp1">true</boolProp>
            <boolProp name="HTTP2Sampler.alpnEnabled">true</boolProp>
            <boolProp name="HTTP2Sampler.fallbackEnabled">true</boolProp>
            <boolProp name="HTTP2Sampler.protocolErrorFallbackEnabled">true</boolProp>
            <boolProp name="HTTP2Sampler.altSvcCacheEnabled">true</boolProp>
            <boolProp name="HTTP2Sampler.http1OnlyCacheEnabled">true</boolProp>
            <boolProp name="HTTP2Sampler.h2cCacheEnabled">true</boolProp>
            <boolProp name="HTTP2Sampler.http2PriorKnowledge">false</boolProp>
