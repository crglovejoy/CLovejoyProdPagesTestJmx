                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">try {
	String pathToUse = vars.getObject(&apos;pageObjList&apos;).getLastObject().getRandomSideColPath()
	vars.put(&apos;newPath&apos;, pathToUse)

