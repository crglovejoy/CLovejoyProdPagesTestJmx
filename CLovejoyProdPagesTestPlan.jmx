          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">
// Preprocessors store a variable called &apos;err&apos; with &apos;true&apos; if an exception occurs.  If we find that we have an &apos;err&apos; variable with &apos;true&apos;,
// set the sample to unsuccessful so the Result Status Action Handler will stop the test for us.

String err = vars.get(&apos;err&apos;)
if (err != null &amp;&amp; err == &quot;true&quot;) {
	prev.setSuccessful(false)
