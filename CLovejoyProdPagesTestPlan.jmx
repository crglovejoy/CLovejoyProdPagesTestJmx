              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">try {

	/*************************************************************************************************/
	/****  Remove the current PageObject from the PageObjectsList as we&apos;re going back up a level  ****/
	/*************************************************************************************************/
	
	def pageObjList = vars.getObject(&apos;pageObjList&apos;)
	
	// Remove the current Page Object from the list and use the last Page Object to get the return path.
	pageObjList.removeLastObjectInList()
	
	log.info(&quot;Going back to path = https://&quot; + vars.get(&apos;host&apos;) + pageObjList.getLastObject().returnToPagePath)
} catch (Exception ex) {
	vars.put(&apos;err&apos;, &apos;true&apos;)
	throw ex
}


