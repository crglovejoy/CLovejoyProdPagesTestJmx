        <hashTree>
          <com.blazemeter.jmeter.http2.sampler.HTTP2Sampler guiclass="com.blazemeter.jmeter.http2.sampler.gui.HTTP2SamplerGui" testclass="com.blazemeter.jmeter.http2.sampler.HTTP2Sampler" testname="GoToStartingPage_Level0" enabled="true">
            <boolProp name="HTTPSampler.image_parser">true</boolProp>
