          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.regex.Pattern
import java.util.regex.Matcher


/*********************************************************************************************************/
/****  PageObjects Class To Store Product paths and pagination information for each navigation level  ****/
/*********************************************************************************************************/

public class PageObjects {
	private String[] productPicPathArr
	private String[] sideColPathArr
	private Random rnd
	public Boolean onFirstPage
	public int totalPages
	public int currentPage
	public int pageSize
	public int nextPage
	public String returnToPagePath

	PageObjects() {
		this.rnd = new Random()
		this.productPicPathArr = []
		this.sideColPathArr = []
		this.onFirstPage = false
		this.totalPages = 0
		this.currentPage = 0
		this.pageSize = 0
		this.nextPage = 0
		this.returnToPagePath = &quot;&quot;
	}

	// Populate the link arrays (product picture links and left column filter links).

	// A PathsToStore value of -1 means store all match values found.  If the colPathsToStore value is null,
	// attempt to use the returnToPagePath string value to create a regex pattern.
	void processLinkStrings(String pathsBlockStr, Pattern colPathRxPattern, int picPathsToStore, int colPathsToStore) {
		this.productPicPathArr = []
		this.sideColPathArr = []

		if (pathsBlockStr?.trim().isEmpty()) {
			return
		}

		// find the picture paths on the page
		// Example of what we&apos;re looking for: href=&quot;/outlet/344LGD15/95283.html&quot;
		Pattern picPattern = ~/href=\&quot;(\/outlet\/.*?\/\d+\.html)\&quot;/
		this.productPicPathArr = PageObjects.getArrayFromPattern(this.rnd, pathsBlockStr, picPattern, picPathsToStore)

		// If we found no picture paths on this page, don&apos;t bother with finding left column links.  The test logic should move
		// on rather than attempt to exercise any of the left column links if they lead to empty results.
		if (this.productPicPathArr.size() == 0 || colPathsToStore == 0) {
			return
		}
		
		if (colPathRxPattern != null) {
			// Use the Pattern variable passed to us to extract our links.
			this.sideColPathArr = PageObjects.getArrayFromPattern(this.rnd, pathsBlockStr, colPathRxPattern, colPathsToStore)
		} else {
			// Attempt to create a pattern from the returnToPagePath string value.
			Pattern generatedPat = PageObjects.getPatternFromReturnToPagePath(this.returnToPagePath)
			this.sideColPathArr = PageObjects.getArrayFromPattern(this.rnd, pathsBlockStr, generatedPat, colPathsToStore)
		}
	}

	// Save the pagination details
	void processPaginationStrings(String totNumItemsStr, String currPageStr, String pageSizeStr, String totPagesStr, String onFirstPageStr) {
		this.onFirstPage = false
		this.totalPages = 0
		this.currentPage = 0
		this.pageSize = 0
		this.nextPage = 0
		int totalItems = 0

		if (totNumItemsStr?.trim().isEmpty() || currPageStr?.trim().isEmpty() || pageSizeStr?.trim().isEmpty() || totPagesStr?.trim().isEmpty() || onFirstPageStr?.trim().isEmpty()) {
			return
		}
		
		totalItems = totNumItemsStr.trim().toInteger()
		this.currentPage  = currPageStr.trim().toInteger()
		this.nextPage = this.currentPage
		this.pageSize = pageSizeStr.trim().toInteger()
		this.totalPages = totPagesStr.trim().toInteger()
		this.onFirstPage = Boolean.parseBoolean(onFirstPageStr.trim())
		
		// Assuming less than 10 items on the last page is not enough items when looping over the page and selecting items randomly - many duplicate selections?
		// Subtracting 1 from the total number of pages to choose from if the conditions fit (below) - we have more than 1 page, our current page is not
		// the last page, and the last page contains less than 10 items = subtract 1 from the total pages we will choose to operate on.
		if (this.totalPages &gt; 1 &amp;&amp; this.currentPage &lt; this.totalPages) {
			if (totalItems % this.pageSize &lt; 10) {
				this.totalPages -= 1
			}
		}
	}

	String getRandomPicPath() {
		if (this.productPicPathArr.size() == 0) {
			throw new Exception(&quot;productPicPathArr is an empty array&quot;)
		}
		
		this.productPicPathArr[this.rnd.nextInt(this.productPicPathArr.size())]
	}

	Boolean productPicPathArrHasEntries() {
		this.productPicPathArr.size() &gt; 0
	}

	String getRandomSideColPath() {
		if (this.sideColPathArr.size() == 0) {
			throw new Exception(&quot;sideColPathArr is an empty array&quot;)
		}

		this.sideColPathArr[this.rnd.nextInt(this.sideColPathArr.size())].replace(&apos;&amp;amp;&apos;,&apos;&amp;&apos;)
	}

	Boolean sideColPathArrHasEntries() {
		this.sideColPathArr.size() &gt; 0
	}

	// Call this prior to attempting a result page change - will get a new page number  at random while ensuring we don&apos;t
	// land on the same page number already being viewed.
	void setNewRandomNextPage() {
		if (this.totalPages == 0) {
			throw new Exception(&quot;totalPages is 0&quot;)
		}

		// Make sure we get a page number that is different than the currentPage.
		if (this.totalPages &gt; 1) {
			this.nextPage = this.currentPage
			while (nextPage == this.currentPage) {
				nextPage = this.rnd.nextInt(this.totalPages) + 1
			}
		} else {
			this.nextPage = 1
		}
	}

	Boolean nextPageIsDifferentThanCurrentPage() {
		this.nextPage != this.currentPage
	}


	// Set the return path to the current page that we just landed on.  In the post processors, call the newly created 
	// PageObjects setReturnPath method with the true URL we landed on.
	void setReturnPath(String path) {
		if (path == null) {
			this.returnToPagePath = &quot;&quot;
			return
		}

		String newPath = path.trim()
		
		if (path.contains(&quot;https://&quot;)) {
			String[] parts = newPath.split(&apos;/&apos;)
			newPath = parts[-1]
		}
		
		this.returnToPagePath = newPath
	}


	/***************************************************************************/
	/****************************  STATIC METHODS  *****************************/
	/***************************************************************************/

	static Pattern getPatternFromReturnToPagePath(String pagePath) {
		if (pagePath.isEmpty()) {
			return null
		}

		String[] pathParts = pagePath.split(&apos;/&apos;)
		String newPatStr = pathParts[-1].replace(&apos;&amp;&apos;,&apos;&amp;amp;&apos;)
		String escapedPatStr = Pattern.quote(newPatStr)
		return ~/href=\&quot;(\/${escapedPatStr}.*?)\&quot;/
	}

	static String[] getArrayFromPattern(Random rnd, String inputStr, Pattern pattern, int maxNumToSave) {
		String[] returnArr = []
		
		if (pattern == null || maxNumToSave == 0) {
			return returnArr
		}

		Matcher matcher = inputStr =~ pattern

		if (matcher.size() == 0) {
			return returnArr
		}

		List&lt;String&gt; valuesList = matcher.collect{ it[1] }
		
		if (maxNumToSave &lt; 0 || valuesList.size() &lt;= maxNumToSave) {
			return valuesList as String[]
		}

		returnArr = new String[maxNumToSave]
		for (int x = 0; x &lt; maxNumToSave; x++) {
			returnArr[x] = valuesList[rnd.nextInt(valuesList.size())]
		}

		returnArr
	}

	// This will only handle the management of one new or revised query parameter at a time.  No value1=1&amp;value2=2 bundling of query parameters.
	// Call this to retrieve a new page path for the next request.  In the post processors, call the newly created PageObjects setReturnPath
	// method with the true URL we landed on.
	static String calculateNewPagePath(String pagePath, String queryParam) {
		if (queryParam?.trim().isEmpty() || pagePath?.trim().isEmpty()) {
			return &quot;&quot;
		}

		String newPath = pagePath

		def parts = queryParam.split(&apos;=&apos;, 2)
		if (parts.size() != 2) {
		   throw new Exception(&quot;Expected format &apos;key=value&apos;, got: ${queryParam}&quot;)
		}
		
		String key = parts[0]
		String value = parts[1]
		
		// Escape key in case it contains regex special chars
		String escapedKey = Pattern.quote(key)
		def pattern = ~/(?&lt;=^|[?&amp;])${escapedKey}=[^&amp;\r\n]*/
		
		if (newPath =~ pattern) {
		   return newPath.replaceFirst(pattern, &quot;${key}=${value}&quot;)
		} else {
		   // key not found — append it
		   String separator = newPath.contains(&apos;?&apos;) ? &apos;&amp;&apos; : &apos;?&apos;
		   return &quot;${newPath}${separator}${key}=${value}&quot;
		}
	}
	

	/***************************************************************************/
	/**************************  FOR DEBUGGING ONLY  ***************************/
	/***************************************************************************/
	
	int getProductPathArrSize() {
		this.productPicPathArr.size()
	}

	int getSideColPathArrSize() {
		this.sideColPathArr.size()
	}


	/***************************************************************************/
	/********************  GETTER AND SETTER OVERRIDES  ************************/
	/***************************************************************************/

	void setProductPicPathArr(String[] arr) {
		throw new Exception(&quot;Cannot set productPicLinkPathArr&quot;)
	}
	String[] getProductPicPathArr() {
		throw new Exception(&quot;Cannot get productPicLinkPathArr&quot;)
	}
	void setSideColPathArr(String[] arr) {
		throw new Exception(&quot;Cannot set sideBarFilterPathArr&quot;)
	}
	String[] getSideColPathArr() {
		throw new Exception(&quot;Cannot get sideBarFilterPathArr&quot;)
	}
	void setOnFirstPage(Boolean firstPage) {
		throw new Exception(&quot;Cannot set onFirstPage&quot;)
	}
	void setTotalPages(int totPgs) {
		throw new Exception(&quot;Cannot set totalPages&quot;)
	}
	void setCurrentPage(int currPg) {
		throw new Exception(&quot;Cannot set currentPage&quot;)
	}
	void setPageSize(int pgSize) {
		throw new Exception(&quot;Cannot set pageSize&quot;)
	}
	void setNextPage(int nextPg) {
		throw new Exception(&quot;Cannot set nextPage&quot;)
	}
	void setReturnToPageUrl() {
		throw new Exception(&quot;Cannot set returnToPageUrl&quot;)
	}
	void setSortQueryParm() {
		throw new Exception(&quot;Cannot set sortQueryParm&quot;)
	}
} // END CLASS: PageObjects


/******************************************************/
/****  PageObjectsList Class to Store PageObjects  ****/
/******************************************************/

public class PageObjectsList {
	private ArrayList&lt;PageObjects&gt; pageObjectsList

	PageObjectsList() {
		this.pageObjectsList = new ArrayList&lt;PageObjects&gt;()
	}

	void addPageObject(PageObjects pgObj) {
		this.pageObjectsList.add(pgObj)
	}

	int pageObjectsListSize() {
		this.pageObjectsList.size()
	}

	void removeLastObjectInList() {
		if (!this.pageObjectsList.isEmpty()) {
			this.pageObjectsList.removeLast()
		}
	}

	PageObjects getLastObject() {
		if (!this.pageObjectsList.isEmpty()) {
			this.pageObjectsList.getLast()
		} else {
			null
		}
	}


	/***************************************************************************/
	/********************  GETTER AND SETTER OVERRIDES  ************************/
	/***************************************************************************/
	
	ArrayList getPageObjectsList() {
		throw new Exception(&quot;Cannot get pageObjectsList&quot;)
	}
	void setPageObjectsList() {
		throw new Exception(&quot;Cannot set pageObjectsList&quot;)
	}
}  // END CLASS: PageObjectsList


/*********************************************************************************************************/
/****  TransactionControllerDispManager Class To help generate sampler label variables in realtime    ****/
/*********************************************************************************************************/

// Using the __groovy script approach for adding the level number to the sampler names is tedious and error prone when getting the 
// page objects list instance and then calling the method to provide array size back to us.  Using this approach to manage the dynamic 
// sampler name generation.
public class TransactionControllerDispManager {
	public int transDispPrevLevel
	public int transDispCurrLevel
	public int transDispNextLevel

	TransactionControllerDispManager() {
		this.transDispPrevLevel = 0
		this.transDispCurrLevel = 0
		this.transDispNextLevel = 1
	}

	void DrillingDeeper() {
		this.transDispPrevLevel = this.transDispCurrLevel
		this.transDispCurrLevel = this.transDispNextLevel
		this.transDispNextLevel++
	}

	void ClimbingBackToTheSurface() {
		this.transDispNextLevel = this.transDispCurrLevel
		this.transDispCurrLevel = this.transDispPrevLevel 
		this.transDispPrevLevel = this.transDispPrevLevel &gt; 0 ? this.transDispPrevLevel - 1 : 0
	}


	/***************************************************************************/
	/********************  GETTER AND SETTER OVERRIDES  ************************/
	/***************************************************************************/
	
	void setTransDispPrevLevel(int val) {
		throw new Exception(&quot;Cannot set transDispPrevLevel&quot;)
	}
	void setTransDispCurrLevel(int val) {
		throw new Exception(&quot;Cannot set transDispCurrLevel&quot;)
	}
	void setTransDispNextLevel(int val) {
		throw new Exception(&quot;Cannot set transDispNextLevel&quot;)
	}
}



/**********************************************************************/
/****  Store Our Class Factories Here so Threads can Instantiate  ****/
/**********************************************************************/


props.put(&quot;page.object.factory&quot;, { -&gt; new PageObjects() })
props.put(&quot;page.object.list.factory&quot;, { -&gt; new PageObjectsList() })
props.put(&quot;trans.cont.label.factory&quot;, { -&gt; new TransactionControllerDispManager() })



/******************************************/
/****  Setup our array of sort values  ****/
/******************************************/

// convert our sortStrs user defined variables value to an array and store it.
String[] sortStrsArr = []
if (vars.get(&apos;numItersToDoBeforeTriggerSortTypeChange&apos;).toInteger() &gt; 0) {
	sortStrsArr = vars.get(&apos;sortStrs&apos;).split(&apos;&amp;&apos;)

	if (sortStrsArr.size() == 0) {
		throw new Exception(&quot;sortStrs variable provides no sort values. Either provide sort values or set numItersToDoBeforeTriggerSortTypeChange to less than 1&quot;)
	}
}

props.put(&apos;sort.vals.arr&apos;, sortStrsArr)

