              <hashTree/>
              <BoundaryExtractor guiclass="BoundaryExtractorGui" testclass="BoundaryExtractor" testname="Left Col Links String Block Extractor" enabled="true">
                <stringProp name="BoundaryExtractor.useHeaders">false</stringProp>
                <stringProp name="BoundaryExtractor.refname">targetLinksStrBlock</stringProp>
                <stringProp name="BoundaryExtractor.lboundary">&lt;h1 class=&quot;page-header&quot;&gt;${pageContentHeader}&lt;/h1&gt;</stringProp>
                <stringProp name="BoundaryExtractor.rboundary">data-hypernova-id</stringProp>
                <stringProp name="BoundaryExtractor.default"></stringProp>
                <boolProp name="BoundaryExtractor.default_empty_value">true</boolProp>
                <stringProp name="BoundaryExtractor.match_number">$1$</stringProp>
                <stringProp name="TestPlan.comments">Making sure we only work with products and URL paths falling below the ${pageContentHeader} header - extract the block of text between the boundaries and then use the Page Objects class to parse out the links in the extracted text.</stringProp>
              </BoundaryExtractor>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Create Level${transDispNextLevel} Page Object" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script"> import java.util.regex.Pattern

try {

	/***************************************/
	/**** Setup our PageObjects object  ****/
	/***************************************/
	
	def factory = props.get(&apos;page.object.factory&apos;)
	def pageObject = factory.call()

	pageObject.setReturnPath(prev.getUrlAsString())
	
	// Example of what we&apos;re looking for: href=&quot;/outlet.html?category=13765&amp;amp;filter=type:cutters-slicers&quot;
	//Pattern colPathPattern = ~/href=\&quot;(\/outlet.html\?.*?category=\d+&amp;amp;.*?)\&quot;/
	pageObject.processLinkStrings(vars.get(&apos;targetLinksStrBlock&apos;), null, -1, 50)
	//pageObject.processPaginationStrings(vars.get(&apos;paginationStr_1_g1&apos;), vars.get(&apos;paginationStr_1_g2&apos;), vars.get(&apos;paginationStr_1_g3&apos;), vars.get(&apos;paginationStr_1_g4&apos;),  vars.get(&apos;paginationStr_1_g5&apos;))
	
	
	// Stage a next page number to navigate to if there is another page available (default is page 1)
	//pageObject.setNewRandomNextPage()
	vars.remove(&quot;targetLinksStrBlock&quot;)
	
	
	/*******************************************************/
	/**** Add our PageObjects to the Page Objects List  ****/
	/*******************************************************/
	
	def pageObjList = vars.getObject(&apos;pageObjList&apos;)
	pageObjList.addPageObject(pageObject)

	log.info(&quot;Found Picture Links = &quot; + pageObject.productPicPathArrHasEntries().toString() + &quot; / Found Left Column Links = &quot; + pageObject.sideColPathArrHasEntries().toString())


	/*******************************************/
	/****  Manage the sampler label values  ****/
	/*******************************************/

	def labelMgr = vars.getObject(&apos;labelMgr&apos;)
	labelMgr.DrillingDeeper()

	vars.put(&apos;transDispPrevLevel&apos;, labelMgr.transDispPrevLevel.toString())
	vars.put(&apos;transDispCurrLevel&apos;, labelMgr.transDispCurrLevel.toString())
	vars.put(&apos;transDispNextLevel&apos;, labelMgr.transDispNextLevel.toString())
	vars.putObject(&apos;labelMgr&apos;, labelMgr)
	
	
	/************************/
	/****  Debug Output  ****/
	/************************/
	
	if (vars.get(&apos;debug&apos;).trim() == &apos;true&apos;) {
		if (!pageObject.productPicPathArrHasEntries()) {
			log.info(&quot;No entries in productPicPathArr&quot;)
		} else {
			log.info(&quot;pic link arr size = &quot; + pageObject.getProductPathArrSize().toString())
			log.info(&quot;pic product link example = &quot; + pageObject.getRandomPicPath())
		}
		
		log.info(&quot;currentPage = &quot; + pageObject.currentPage)
		log.info(&quot;pageSize = &quot; + pageObject.pageSize)
		log.info(&quot;onFirstPage = &quot; + pageObject.onFirstPage)
		log.info(&quot;totalPages = &quot; + pageObject.totalPages)
		log.info(&quot;nextPage = &quot; + pageObject.nextPage)
		log.info(&quot;nextPageIsDifferentThanCurrentPage = &quot; + pageObject.nextPageIsDifferentThanCurrentPage())
	
		if (!pageObject.sideColPathArrHasEntries()) {
			log.info(&quot;No entries in sideColPathArr&quot;)
		} else {
			log.info(&quot;left col link arr size = &quot; + pageObject.getSideColPathArrSize().toString())
			log.info(&quot;left col link example = &quot; + pageObject.getRandomSideColPath())
		}
	
		log.info(&quot;pageObjectReturnToPagePath = &quot; + pageObject.returnToPagePath)
		log.info(&quot;pageObjectListSize = &quot; + pageObjList.pageObjectsListSize().toString())
		log.info(&quot;pathUrlCalledToGetHere = &quot; + prev.getUrlAsString())
	}
} catch (Exception ex) {
	prev.setSuccessful(false)
	throw ex
}
</stringProp>
