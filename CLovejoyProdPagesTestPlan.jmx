          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="GoChangeSort_Level0 Set newPath and sortVal" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
	def pageObj = vars.getObject(&apos;pageObjList&apos;).getLastObject()
	String nextSortVal = vars.get(&apos;nextSortVal&apos;)

	if (nextSortVal.startsWith(&apos;_&apos;)) {
		nextSortVal = nextSortVal.drop(1)
	}
	
	String newPath = pageObj.calculateNewPagePath(pageObj.returnToPagePath, nextSortVal)
	vars.put(&apos;newPath&apos;, newPath)
	
	log.info(&quot;Going to path = https://&quot; + vars.get(&apos;host&apos;) + newPath)
} catch (Exception ex) {
	vars.put(&apos;err&apos;, &quot;true&quot;)
	throw ex
}</stringProp>
