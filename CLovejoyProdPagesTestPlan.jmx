            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="GoToStartingMain_Level0  Logging and Set sortOrderInUse" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">
try {

	/****************************************************************/
	/****  Initialize some setup variables here for each thread  ****/
	/****************************************************************/

	vars.putObject(&apos;sortIdx&apos;, 0)
	vars.put(&apos;sortVal&apos;,&quot;&quot;)
	
	String[] sortStrsArr = props.get(&apos;sort.vals.arr&apos;)
	
	if (sortStrsArr.size() &gt; 0) {
		vars.put(&apos;nextSortVal&apos;, &quot;_&quot; + sortStrsArr[0])
	} else {
		vars.put(&apos;nextSortVal&apos;, &quot;ERROR&quot;)
	}
	
	/*******************************************/
	/****  Manage the sampler label values  ****/
	/*******************************************/
	
	def labelFactory = props.get(&quot;trans.cont.label.factory&quot;)
	def labelMgr = labelFactory.call()
	
	vars.put(&apos;transDispPrevLevel&apos;, labelMgr.transDispPrevLevel.toString())
	vars.put(&apos;transDispCurrLevel&apos;, labelMgr.transDispCurrLevel.toString())
	vars.put(&apos;transDispNextLevel&apos;, labelMgr.transDispNextLevel.toString())
	vars.putObject(&apos;labelMgr&apos;, labelMgr)
	
	
	log.info(&quot;Going to path = https://&quot; + vars.get(&apos;host&apos;) + &quot;/outlet.html&quot;)
	
} catch (Exception ex) {
	vars.put(&apos;err&apos;, &apos;true&apos;)
	throw ex
}

</stringProp>
            </JSR223PreProcessor>
