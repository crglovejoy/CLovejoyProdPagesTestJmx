              <collectionProp name="Arguments.arguments"/>
            </elementProp>
            <intProp name="HTTP2Sampler.uiTabIndex">0</intProp>
            <boolProp name="HTTP2Sampler.http1_upgrade">false</boolProp>
            <stringProp name="HTTP2Sampler.profile">browser-like</stringProp>
            <boolProp name="HTTP2Sampler.enableHttp3">false</boolProp>
