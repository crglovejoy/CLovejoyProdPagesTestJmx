            <boolProp name="HTTP2Sampler.h2cCacheEnabled">true</boolProp>
            <boolProp name="HTTP2Sampler.http2PriorKnowledge">false</boolProp>
            <stringProp name="HTTP2Sampler.happyEyeballsDelayMs">250</stringProp>
            <stringProp name="HTTP2Sampler.http3BrokenCooldownMs">300000</stringProp>
            <stringProp name="HTTP2Sampler.http1OnlyCooldownMs">300000</stringProp>
            <stringProp name="HTTP2Sampler.h2cCacheTtlMs">300000</stringProp>
